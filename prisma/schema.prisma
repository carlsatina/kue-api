// Prisma schema for Kue MVP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  admin
  staff
}

enum AssistantInviteStatus {
  pending
  accepted
  revoked
}

enum SessionStatus {
  draft
  open
  closed
}

enum SessionMode {
  usual
  tournament
}

enum FeeMode {
  flat
  per_game
}

enum CourtStatus {
  available
  in_match
  maintenance
}

enum PlayerStatus {
  pending_payment
  waitlisted
  checked_in
  present
  away
  done
}

enum QueueType {
  singles
  doubles
}

enum QueueStatus {
  queued
  assigned
  removed
}

// How a session forms matches out of the queue. `pairs` is the classic flow:
// an entry is a ready-made side (1 for singles, 2 for doubles) and a match is
// two entries. `open_play` is the racket lineup: players drop in individually
// or with a partner, and a court call takes whole entries off the head of the
// line until it has enough players, then splits them into two teams.
enum QueueMode {
  pairs
  open_play
}

// How the four players a court call picked get split into two teams.
enum PairingStrategy {
  arrival      // lineup order is the law: first two vs next two
  balanced     // minimise the rating gap between the two teams
  avoid_repeat // balanced, but avoid partners/opponents from recent matches
}

enum QueueSource {
  staff
  player
  auto_requeue
}

enum MatchStatus {
  proposed
  active
  ended
  cancelled
}

enum MatchType {
  singles
  doubles
}

enum GroupRole {
  owner
  manager
  member
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      RoleName   @unique
  createdAt DateTime   @default(now())
  users     UserRole[]

  @@map("roles")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String?    @map("full_name")
  emailVerifiedAt DateTime? @map("email_verified_at")
  emailVerifyTokenHash String? @map("email_verify_token_hash")
  emailVerifyTokenExpiresAt DateTime? @map("email_verify_token_expires_at")
  passwordResetTokenHash String? @map("password_reset_token_hash")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  activeWorkspaceId String? @db.Uuid @map("active_workspace_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  roles        UserRole[]
  sessions     Session[]  @relation("SessionCreator")
  courts       Court[]    @relation("CourtCreator")
  players      Player[]   @relation("PlayerCreator")
  teams        Team[]     @relation("TeamCreator")
  createdGroups Group[]   @relation("GroupCreator")
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  activeWorkspace Workspace? @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMemberships WorkspaceMember[] @relation("WorkspaceUser")

  @@index([emailVerifyTokenHash])
  @@index([passwordResetTokenHash])
  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String   @db.Uuid @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner       User                     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  activeForUsers User[]                @relation("ActiveWorkspace")
  members     WorkspaceMember[]
  sessions    Session[]
  courts      Court[]
  players     Player[]
  teams       Team[]
  groups      Group[]
  invites     SessionAssistantInvite[]

  @@index([ownerId])
  @@map("workspaces")
}

model UserRole {
  userId String @db.Uuid @map("user_id")
  roleId String @db.Uuid @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id             String           @id @default(uuid()) @db.Uuid
  name           String
  location       String?
  startsAt       DateTime?        @map("starts_at")
  endsAt         DateTime?        @map("ends_at")
  status         SessionStatus
  mode           SessionMode      @default(usual) @map("mode")
  gameType       MatchType        @default(doubles) @map("game_type")
  feeMode        FeeMode          @map("fee_mode")
  feeAmount      Decimal          @default(0) @map("fee_amount") @db.Decimal(10,2)
  requirePaymentToJoin Boolean    @default(false) @map("require_payment_to_join")
  paymentDeadline DateTime?       @map("payment_deadline")
  defaultBracketType String?      @map("default_bracket_type")
  regularJoinLimit Int            @default(0) @map("regular_join_limit")
  newJoinerLimit   Int            @default(0) @map("new_joiner_limit")
  returnToQueue  Boolean          @default(true) @map("return_to_queue")
  queueMode      QueueMode        @default(pairs) @map("queue_mode")
  pairingStrategy PairingStrategy @default(arrival) @map("pairing_strategy")
  announcements  String?
  createdBy      String?          @db.Uuid @map("created_by")
  workspaceId    String           @db.Uuid @map("workspace_id")
  groupId        String?          @db.Uuid @map("group_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  closedAt       DateTime?        @map("closed_at")

  creator        User?            @relation("SessionCreator", fields: [createdBy], references: [id])
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  group          Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  courtSessions  CourtSession[]
  sessionPlayers SessionPlayer[]
  queueEntries   QueueEntry[]
  matches        Match[]
  payments       Payment[]
  shareLinks     ShareLink[]
  sessionShareLinks SessionShareLink[]
  sessionInviteLinks SessionInviteLink[]
  bracketOverrides BracketOverride[]
  assistantInvites SessionAssistantInvite[]
  queueEvents    QueueEvent[]

  @@index([status])
  @@index([workspaceId])
  @@index([groupId])
  @@map("sessions")
}

model BracketOverride {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @db.Uuid @map("session_id")
  matchId     String   @map("match_id")
  bracketType String   @map("bracket_type")
  matchFormat String   @map("match_format")
  winnerId    String?  @map("winner_id")
  scoreJson   Json?    @map("score_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, matchId, bracketType, matchFormat])
  @@index([sessionId])
  @@map("bracket_overrides")
}

model SessionInviteLink {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  sessionId String   @db.Uuid @map("session_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_invite_links")
}

// A workspace is one queue master (the owner) plus their assistants. An
// assistant belongs to a single workspace and shares the owner's full view:
// they can create, delete, and view every session in that workspace.
model WorkspaceMember {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid @map("workspace_id")
  userId      String   @db.Uuid @map("user_id")
  invitedBy   String?  @db.Uuid @map("invited_by")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model SessionAssistantInvite {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String?               @db.Uuid @map("workspace_id")
  sessionId      String?               @db.Uuid @map("session_id")
  email          String
  tokenHash      String                @unique @map("token_hash")
  status         AssistantInviteStatus @default(pending)
  invitedBy      String?               @db.Uuid @map("invited_by")
  expiresAt      DateTime?             @map("expires_at")
  acceptedAt     DateTime?             @map("accepted_at")
  acceptedUserId String?               @db.Uuid @map("accepted_user_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([sessionId])
  @@index([email])
  @@map("session_assistant_invites")
}

model Court {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  notes     String?
  active    Boolean        @default(true)
  createdBy String?        @db.Uuid @map("created_by")
  workspaceId String       @db.Uuid @map("workspace_id")
  createdAt DateTime       @default(now()) @map("created_at")
  deletedAt DateTime?      @map("deleted_at")

  creator       User?         @relation("CourtCreator", fields: [createdBy], references: [id])
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courtSessions CourtSession[]

  @@index([createdBy])
  @@index([workspaceId])
  @@map("courts")
}

model CourtSession {
  id             String      @id @default(uuid()) @db.Uuid
  sessionId      String      @db.Uuid @map("session_id")
  courtId        String      @db.Uuid @map("court_id")
  status         CourtStatus
  currentMatchId String?     @db.Uuid @map("current_match_id")
  nextMatchId    String?     @db.Uuid @map("next_match_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  court     Court   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([sessionId, courtId])
  @@index([sessionId])
  @@map("court_sessions")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  color     String?
  createdBy String?  @db.Uuid @map("created_by")
  workspaceId String @db.Uuid @map("workspace_id")
  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  creator           User?              @relation("TeamCreator", fields: [createdBy], references: [id])
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  players           Player[]
  matchParticipants MatchParticipant[]

  @@index([createdBy])
  @@index([workspaceId])
  @@map("teams")
}

// A group is a social roster — a club or barkada that plays together across
// sessions. Distinct from Team, which is the tournament construct (a player has
// at most one Team, but may belong to many Groups).
model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  workspaceId String    @db.Uuid @map("workspace_id")
  createdBy   String?   @db.Uuid @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User?             @relation("GroupCreator", fields: [createdBy], references: [id])
  members     GroupMember[]
  sessions    Session[]
  inviteLinks GroupInviteLink[]

  @@index([workspaceId])
  @@index([createdBy])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @db.Uuid @map("group_id")
  playerId String    @db.Uuid @map("player_id")
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at")

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([groupId, playerId])
  @@index([playerId])
  @@map("group_members")
}

// Tokenized public link that lets a player add themselves to a group's roster.
model GroupInviteLink {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  groupId   String    @db.Uuid @map("group_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_invite_links")
}

model Player {
  id        String          @id @default(uuid()) @db.Uuid
  fullName  String          @map("full_name")
  nickname  String?
  skillLevel String?        @map("skill_level")
  contact   String?
  teamId    String?         @db.Uuid @map("team_id")
  createdBy String?         @db.Uuid @map("created_by")
  workspaceId String        @db.Uuid @map("workspace_id")
  createdAt DateTime        @default(now()) @map("created_at")
  deletedAt DateTime?       @map("deleted_at")

  creator           User?             @relation("PlayerCreator", fields: [createdBy], references: [id])
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team              Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sessionPlayers    SessionPlayer[]
  groupMemberships  GroupMember[]
  queueEntryPlayers QueueEntryPlayer[]
  matchParticipants MatchParticipant[]
  payments          Payment[]
  shareLinks        ShareLink[]

  @@index([createdBy])
  @@index([teamId])
  @@index([workspaceId])
  @@map("players")
}

model SessionPlayer {
  id               String        @id @default(uuid()) @db.Uuid
  sessionId        String        @db.Uuid @map("session_id")
  playerId         String        @db.Uuid @map("player_id")
  status           PlayerStatus
  isNewPlayer      Boolean       @default(false) @map("is_new_player")
  checkedInAt      DateTime      @default(now()) @map("checked_in_at")
  lastPlayedAt     DateTime?     @map("last_played_at")
  gamesPlayed      Int           @default(0) @map("games_played")
  wins             Int           @default(0)
  losses           Int           @default(0)
  totalQueueSeconds Int          @default(0) @map("total_queue_seconds")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, playerId])
  @@map("session_players")
}

model QueueEntry {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid @map("session_id")
  type      QueueType
  status    QueueStatus
  position  Int
  manualOrder Boolean   @default(false) @map("manual_order")
  // A full-court entry whose teams the organiser fixed by hand ("these four
  // asked to play, and these two are partners"). Taken as a whole match.
  lockedTeams Boolean   @default(false) @map("locked_teams")
  source    QueueSource @default(staff)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  session   Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  players   QueueEntryPlayer[]

  @@index([sessionId])
  @@index([sessionId, position])
  @@map("queue_entries")
}

model QueueEntryPlayer {
  entryId  String @db.Uuid @map("entry_id")
  playerId String @db.Uuid @map("player_id")
  // Only set on a lockedTeams entry: which side this player was placed on.
  teamNo   Int?   @map("team_no")
  entry    QueueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  player   Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([entryId, playerId])
  @@map("queue_entry_players")
}

// Append-only log of everything that happens to the lineup. Open play is a
// public queue people watch, so "why did they play before me?" needs an answer
// that isn't someone's memory. entryId is deliberately not a foreign key: the
// log outlives the entries it describes.
model QueueEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid @map("session_id")
  entryId   String?  @db.Uuid @map("entry_id")
  type      String
  actorType String   @map("actor_type")
  actorId   String?  @db.Uuid @map("actor_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("queue_events")
}

model Match {
  id             String      @id @default(uuid()) @db.Uuid
  sessionId      String      @db.Uuid @map("session_id")
  courtSessionId String?     @db.Uuid @map("court_session_id")
  status         MatchStatus
  matchType      MatchType   @map("match_type")
  startedAt      DateTime?   @map("started_at")
  endedAt        DateTime?   @map("ended_at")
  scoreJson      Json?       @map("score_json")
  winnerTeam     Int?        @map("winner_team")
  createdAt      DateTime    @default(now()) @map("created_at")

  session      Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]

  @@index([sessionId])
  @@map("matches")
}

model MatchParticipant {
  matchId    String @db.Uuid @map("match_id")
  playerId   String @db.Uuid @map("player_id")
  teamId     String? @db.Uuid @map("team_id")
  teamNumber Int    @map("team_number")

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@id([matchId, playerId])
  @@index([teamId])
  @@map("match_participants")
}

enum PaymentStatus {
  pending
  confirmed
  rejected
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  sessionId     String        @db.Uuid @map("session_id")
  playerId      String        @db.Uuid @map("player_id")
  amount        Decimal       @db.Decimal(10,2)
  method        String
  note          String?
  proofImageUrl String?       @map("proof_image_url")
  status        PaymentStatus @default(confirmed)
  createdAt     DateTime      @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([sessionId, playerId])
  @@map("payments")
}

model ShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  sessionId String   @db.Uuid @map("session_id")
  playerId  String   @db.Uuid @map("player_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

model SessionShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  sessionId String   @db.Uuid @map("session_id")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_share_links")
}
